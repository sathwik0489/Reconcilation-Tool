# Run scripts/init_env.py to generate a local .env with independent random secrets.
POSTGRES_USER=recon_dev
POSTGRES_PASSWORD=GENERATE_A_RANDOM_PASSWORD
POSTGRES_DB=reconcile
DATABASE_URL=postgresql+psycopg://recon_dev:GENERATE_A_RANDOM_PASSWORD@127.0.0.1:55432/reconcile
JWT_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
CREDENTIAL_KEY=GENERATE_A_FERNET_KEY
APP_ENV=development
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_INTERNAL_URL=http://127.0.0.1:8000
FRONTEND_PUBLIC_URL=http://localhost:3000
# Exact authorized API, OAuth, and PostgreSQL hostnames (no wildcards).
INTEGRATION_ALLOWED_HOSTS=
# Additional explicit authorization for private/loopback addresses, if needed.
INTEGRATION_PRIVATE_HOSTS=
INTEGRATION_MAX_ROWS=10000
# Optional: DATASET_STORAGE=/absolute/private/authorized/storage

# Local preview only; must remain false in production.
ALLOW_DEVELOPMENT_LOGIN=false
